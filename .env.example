# Next.js — copy this file to .env.local for the app, and to .env for docker compose.
# Never commit the filled-in files.

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/board
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/board

# Convex deployment URL, from `npx convex dev` (ends in .convex.cloud)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# --- Convex dashboard / `npx convex env set` ---
# Clerk Frontend API URL, for example https://your-app.clerk.accounts.dev
# CLERK_JWT_ISSUER_DOMAIN=
# Shared HMAC secret. Same value in n8n. Generate with: openssl rand -hex 32
# LENDLOOP_HMAC_SECRET=
# Public production webhook, reachable from Convex Cloud (a tunnel if n8n is on localhost)
# N8N_REQUEST_WEBHOOK_URL=https://your-tunnel.example/webhook/lendloop-request
# Comma-separated Clerk user ids (user_...) promoted to admin on sign-in
# ADMIN_CLERK_IDS=

# --- n8n (read by docker compose from .env) ---
# LENDLOOP_HMAC_SECRET=
# Convex HTTP Actions URL, for example https://your-deployment.convex.site
# CONVEX_SITE_URL=
# openssl rand -hex 32
# N8N_ENCRYPTION_KEY=
